#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform sampler3D identityLut;
layout(set = 0, binding = 1) uniform sampler3D affineLut;
layout(set = 0, binding = 2) uniform sampler3D nonlinearLut;

struct LutCase
{
    vec4 color;
    uvec4 control; // LUT kind, interpolation kind, CPU sample index, reserved.
};

layout(std430, set = 0, binding = 3) readonly buffer Inputs
{
    LutCase values[];
} inputs;

layout(std430, set = 0, binding = 4) writeonly buffer Outputs
{
    vec4 values[];
} outputs;

vec3 tetrahedralLut(sampler3D lut, vec3 color)
{
    const ivec3 size = textureSize(lut, 0);
    const vec3 coordinate = clamp(color, vec3(0.0), vec3(1.0)) * vec3(size - 1);
    const ivec3 low = ivec3(floor(coordinate));
    const ivec3 high = min(low + ivec3(1), size - ivec3(1));
    const vec3 f = coordinate - vec3(low);
    const vec3 c000 = texelFetch(lut, low, 0).rgb;
    const vec3 c111 = texelFetch(lut, high, 0).rgb;
    if (f.x >= f.y) {
        if (f.y >= f.z) {
            const vec3 c100 = texelFetch(lut, ivec3(high.x, low.y, low.z), 0).rgb;
            const vec3 c110 = texelFetch(lut, ivec3(high.x, high.y, low.z), 0).rgb;
            return c000 + f.x * (c100 - c000) + f.y * (c110 - c100) + f.z * (c111 - c110);
        }
        if (f.x >= f.z) {
            const vec3 c100 = texelFetch(lut, ivec3(high.x, low.y, low.z), 0).rgb;
            const vec3 c101 = texelFetch(lut, ivec3(high.x, low.y, high.z), 0).rgb;
            return c000 + f.x * (c100 - c000) + f.z * (c101 - c100) + f.y * (c111 - c101);
        }
        const vec3 c001 = texelFetch(lut, ivec3(low.x, low.y, high.z), 0).rgb;
        const vec3 c101 = texelFetch(lut, ivec3(high.x, low.y, high.z), 0).rgb;
        return c000 + f.z * (c001 - c000) + f.x * (c101 - c001) + f.y * (c111 - c101);
    }
    if (f.z >= f.y) {
        const vec3 c001 = texelFetch(lut, ivec3(low.x, low.y, high.z), 0).rgb;
        const vec3 c011 = texelFetch(lut, ivec3(low.x, high.y, high.z), 0).rgb;
        return c000 + f.z * (c001 - c000) + f.y * (c011 - c001) + f.x * (c111 - c011);
    }
    if (f.z >= f.x) {
        const vec3 c010 = texelFetch(lut, ivec3(low.x, high.y, low.z), 0).rgb;
        const vec3 c011 = texelFetch(lut, ivec3(low.x, high.y, high.z), 0).rgb;
        return c000 + f.y * (c010 - c000) + f.z * (c011 - c010) + f.x * (c111 - c011);
    }
    const vec3 c010 = texelFetch(lut, ivec3(low.x, high.y, low.z), 0).rgb;
    const vec3 c110 = texelFetch(lut, ivec3(high.x, high.y, low.z), 0).rgb;
    return c000 + f.y * (c010 - c000) + f.x * (c110 - c010) + f.z * (c111 - c110);
}

vec3 trilinearLut(sampler3D lut, vec3 color)
{
    const vec3 size = vec3(textureSize(lut, 0));
    const vec3 coordinate =
        (clamp(color, vec3(0.0), vec3(1.0)) * (size - 1.0) + 0.5) / size;
    return textureLod(lut, coordinate, 0.0).rgb;
}

vec3 sampleLut(sampler3D lut, vec3 color, uint interpolation)
{
    return interpolation == 2u ? tetrahedralLut(lut, color) : trilinearLut(lut, color);
}

void main()
{
    const uint index = gl_GlobalInvocationID.x;
    if (index >= inputs.values.length()) return;
    const LutCase inputCase = inputs.values[index];
    vec3 result;
    if (inputCase.control.x == 0u) {
        result = sampleLut(identityLut, inputCase.color.rgb, inputCase.control.y);
    } else if (inputCase.control.x == 1u) {
        result = sampleLut(affineLut, inputCase.color.rgb, inputCase.control.y);
    } else {
        result = sampleLut(nonlinearLut, inputCase.color.rgb, inputCase.control.y);
    }
    outputs.values[index] = vec4(result, 1.0);
}
