#version 450
#extension GL_GOOGLE_include_directive : require
#include "foliage_proxy_cell.glsl"
layout(local_size_x = 64) in;
struct Accum {
    uint weight, r, g, b, nx, ny, nz, rough, leaf;
    uint optical[12];
};
layout(set = 0, binding = 4, std430) readonly buffer Accumulators { Accum accum[]; };
layout(set = 0, binding = 5, std430) buffer Cells { Cell cells[]; };
layout(push_constant) uniform Params {
    vec4 unused;
    uvec4 grid;
}
pc;
void main() {
    uint n = pc.grid.x, id = gl_GlobalInvocationID.x;
    if (id >= n * n * n)
        return;
    uint outId = pc.grid.y + id;
    if (pc.grid.w == 0u) {
        Accum a = accum[id];
        if (a.weight == 0u) {
            cells[outId] = emptyCell();
            return;
        }
        float inv = 1.0 / (float(a.weight) * 255.0);
        vec3 mean = vec3(a.nx, a.ny, a.nz) * inv * 2.0 - 1.0;
        vec3 trans = vec3(0);
        for (uint i = 0u; i < 4u; ++i) {
            vec3 projected = vec3(a.optical[i], a.optical[4u + i], a.optical[8u + i]);
            trans += 0.25 * exp(-4.0 * projected / (16384.0 * 255.0));
        }
        cells[outId] = encodeCell(vec4(a.r, a.g, a.b, a.rough) * inv, mean, float(a.leaf) * inv, trans);
        return;
    }
    uvec3 q = uvec3(id % n, (id / n) % n, id / (n * n)) * 2u;
    uint childN = n * 2u;
    vec4 color = vec4(0);
    vec3 mean = vec3(0), trans[8];
    float leaf = 0, weight = 0;
    for (uint i = 0; i < 8; ++i) {
        uvec3 p = q + uvec3(i & 1u, (i >> 1) & 1u, i >> 2);
        Cell c = cells[pc.grid.z + p.x + childN * (p.y + childN * p.z)];
        trans[i] = transmission(c);
        float w = dot(vec3(1) - trans[i], vec3(1.0 / 3.0));
        if (w <= 0)
            continue;
        vec4 norm = unpackUnorm4x8(c.normal);
        color += unpackUnorm4x8(c.color) * w;
        mean += octDecode(norm.xy) * (1.0 - norm.z) * w;
        leaf += norm.w * w;
        weight += w;
    }
    if (weight <= 0) {
        cells[outId] = emptyCell();
        return;
    }
    vec3 sum = vec3(0);
    for (uint i = 0; i < 8; ++i)
        for (uint axis = 0; axis < 3; ++axis) {
            uint bit = 1u << axis;
            if ((i & bit) == 0u)
                sum[axis] += trans[i][axis] * trans[i | bit][axis];
        }
    cells[outId] = encodeCell(color / weight, mean / weight, leaf / weight, sum * .25);
}
